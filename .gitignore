# ==============================================================================
# .gitignore for Intelligent Industrial Object Sorting System
# CoppeliaSim Edu + Python ZeroMQ Remote API Automation
# ==============================================================================

# ------------------------------------------------------------------------------
# Python Bytecode & Runtime Cache
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
share/
pyvenv.cfg
pip-selfcheck.json

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
private/
credentials.json

# ------------------------------------------------------------------------------
# Logs, Diagnostics & Crash Dumps
# ------------------------------------------------------------------------------
*.log
logs/
*.dmp
coppeliaSim*.log
simZMQ*.log
hs_err_pid*

# ------------------------------------------------------------------------------
# Scratch Scripts & Temporary Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*~
scratch/
scratch_*.py
tmp/
temp/

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm / IntelliJ)
.idea/

# Sublime Text & generic editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Antigravity IDE local cache & system generated logs
.system_generated/

# ------------------------------------------------------------------------------
# Operating System Generated Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.fuse_hidden*

# ------------------------------------------------------------------------------
# Testing, Code Coverage & Linting
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Build, Packaging & Distribution Artifacts
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# CoppeliaSim Runtime & Temporary Simulation Artifacts
# (Do NOT ignore .ttt scene files; version-control scenes/sorting_factory.ttt)
# ------------------------------------------------------------------------------
*.ttt.autosave
*.ttt.bak
*.ttm.autosave
*.ttm.bak
coppeliaSim_crash_*.dmp
coppeliaSim_recording_*.mp4
coppeliaSim_recording_*.avi

# ------------------------------------------------------------------------------
# Critical Whitelist & Tracked Assets Guarantee
# ------------------------------------------------------------------------------
# Explicitly ensure core project assets, scenes, and source files remain tracked
!scenes/
!scenes/*.ttt
!config/
!core/
!robot/
!scene/
!*.py
!requirements.txt
!README.md
